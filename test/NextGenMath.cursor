print("--- Constants ---")
print("PI:", Math.PI)
print("E:", Math.E)
print("TAU:", Math.TAU)
print("PHI:", Math.PHI)
print("SQRT2:", Math.SQRT2)

print("\n--- Basic Functions ---")
print("abs(-5):", Math.abs(-5))
print("sign(-10):", Math.sign(-10))
print("round(4.6):", Math.round(4.6))
print("floor(4.6):", Math.floor(4.6))
print("ceil(4.2):", Math.ceil(4.2))

print("\n--- Power & Roots ---")
print("pow(2, 3):", Math.pow(2, 3))
print("sqrt(16):", Math.sqrt(16))
print("cbrt(27):", Math.cbrt(27))
print("root(16, 4):", Math.root(16, 4))

print("\n--- Trigonometry ---")
print("sin(PI/2):", Math.sin(Math.PI / 2))
print("sinDeg(90):", Math.sinDeg(90))
print("cosDeg(0):", Math.cosDeg(0))
print("tanDeg(45):", Math.tanDeg(45))

print("\n--- Interpolation ---")
print("clamp(15, 0, 10):", Math.clamp(15, 0, 10))
print("lerp(0, 100, 0.5):", Math.lerp(0, 100, 0.5))
print("remap(5, 0, 10, 0, 100):", Math.remap(5, 0, 10, 0, 100))

print("\n--- Advanced Math ---")
print("factorial(5):", Math.factorial(5))
print("gcd(48, 18):", Math.gcd(48, 18))
print("lcm(48, 18):", Math.lcm(48, 18))

print("\n--- Statistics ---")
print("sum(1, 2, 3, 4, 5):", Math.sum(1, 2, 3, 4, 5))
print("mean(1, 2, 3, 4, 5):", Math.mean(1, 2, 3, 4, 5))
print("median(1, 5, 2, 4, 3):", Math.median(1, 5, 2, 4, 3))

print("\n--- Geometry & Utils ---")
print("dist(0, 0, 3, 4):", Math.dist(0, 0, 3, 4))
print("hypot(3, 4):", Math.hypot(3, 4))
print("toFixed(Math.PI, 2):", Math.toFixed(Math.PI, 2))
