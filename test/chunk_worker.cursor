// chunk_worker.cursor
// Background worker for calculating chunk block data

onMessage((data) -> {
    print("Worker received task:", data.wrldChunkX, data.wrldChunkZ);
    let wrldChunkX = data.wrldChunkX;
    let wrldChunkZ = data.wrldChunkZ;
    let seed = data.seed;

    // Local copy of height calculation to match terrain seed
    // We can't access PerlinNoise directly if it's not available in workers, 
    // but PerlinNoiseL should be in global scope if Environment.ts works as expected.
    PerlinNoise.seed(seed);

    let getH = (x, z) -> {
        let scale1 = 0.015;
        let scale2 = 0.05;
        let scale3 = 0.1;

        let h1 = PerlinNoise.noise2D(x * scale1, z * scale1) * 35;
        let h2 = PerlinNoise.noise2D(x * scale2, z * scale2) * 12;
        let h3 = PerlinNoise.noise2D(x * scale3, z * scale3) * 4;

        let combined = h1 + h2 + h3 + 12;
        return Math.round(combined);
    };

    let heightCache = [];
    let hxi = -1;
    while (hxi <= 16) {
        let hzi = -1;
        while (hzi <= 16) {
            push(heightCache, getH(wrldChunkX * 16 + hxi, wrldChunkZ * 16 + hzi));
            hzi = hzi + 1;
        }
        hxi = hxi + 1;
    }

    let localGetH = (lx, lz) -> {
        return heightCache[(lx + 1) * 18 + (lz + 1)];
    };

    let blocks = [];
    let bx = 0;
    while (bx < 16) {
        let bz = 0;
        while (bz < 16) {
            let wrldX = (wrldChunkX * 16) + bx;
            let wrldZ = (wrldChunkZ * 16) + bz;

            let h = localGetH(bx, bz);
            let h_nx = localGetH(bx - 1, bz);
            let h_px = localGetH(bx + 1, bz);
            let h_nz = localGetH(bx, bz - 1);
            let h_pz = localGetH(bx, bz + 1);

            let h_nw = localGetH(bx - 1, bz - 1);
            let h_ne = localGetH(bx + 1, bz - 1);
            let h_sw = localGetH(bx - 1, bz + 1);
            let h_se = localGetH(bx + 1, bz + 1);

            let randVal = Math.abs(Math.sin(wrldX * 12.9898 + wrldZ * 78.233)) * 43758.5453;
            let rV = randVal - Math.floor(randVal);
            let dirtDepth = 3 + Math.floor(rV * 3);

            let currY = 0;
            while (currY <= h) {
                let isExposed = (currY >= h - 1 || currY > h_nx || currY > h_px || currY > h_nz || currY > h_pz);
                if (isExposed) {
                    let type = "stone";
                    if (currY == h) {
                        type = "grass";
                    }
                    else if (currY > h - dirtDepth) {
                        type = "dirt";
                    }

                    // AO Calculation
                    let top_v0 = 0; if (h_nx > currY) {
                        top_v0 = top_v0 + 1;
                    } if (h_nz > currY) {
                        top_v0 = top_v0 + 1;
                    } if (h_nw > currY) {
                        top_v0 = top_v0 + 1;
                    }
                    let top_v1 = 0; if (h_px > currY) {
                        top_v1 = top_v1 + 1;
                    } if (h_nz > currY) {
                        top_v1 = top_v1 + 1;
                    } if (h_ne > currY) {
                        top_v1 = top_v1 + 1;
                    }
                    let top_v2 = 0; if (h_px > currY) {
                        top_v2 = top_v2 + 1;
                    } if (h_pz > currY) {
                        top_v2 = top_v2 + 1;
                    } if (h_se > currY) {
                        top_v2 = top_v2 + 1;
                    }
                    let top_v3 = 0; if (h_nx > currY) {
                        top_v3 = top_v3 + 1;
                    } if (h_pz > currY) {
                        top_v3 = top_v3 + 1;
                    } if (h_sw > currY) {
                        top_v3 = top_v3 + 1;
                    }

                    push(blocks, {
                        x: wrldX, y: currY, z: wrldZ,
                        type: type,
                        ao: [top_v0, top_v3, top_v2, top_v1]
                    });

                    // Trees (Simple data format)
                    if (currY == h && type == "grass" && rV < 0.0075) {
                        push(blocks, {
                            x: wrldX, y: h, z: wrldZ,
                            type: "tree",
                            height: 3 + Math.floor(rV * 100) % 5,
                            rV: rV
                        });
                    }
                }
                currY = currY + 1;
            }
            bz = bz + 1;
        }
        bx = bx + 1;
    }

    send({
        wrldChunkX: wrldChunkX,
        wrldChunkZ: wrldChunkZ,
        blocks: blocks
    });
});
