Window.create(900, 500, "Neon Dash: Evolution")

// --- Configuration ---
let worldSpeed = 6.5
let gravity = 1.15
let jumpForce = -17.5
let rotationSpeed = 8

// --- Colors (Premium Dash Palette) ---
let colorBg = "#05050A"
let colorGrid = "#12142B"
let colorPlayer = "#00FFCC"
let colorPlayerGlow = "#00CCAA"
let colorSpike = "#FF0055"
let colorBlock = "#1A1B3A"
let colorFloor = "#0D0E1F"
let colorWhite = "#FFFFFF"
let colorProgress = "#F72585"

// --- Game State ---
let player = { x: 150, y: 350, w: 35, h: 35, vy: 0, onGround: false, rotation: 0, alive: true }
let cameraX = 0
let levelWidth = 6000
let particles = []
let bgParticles = []
let gameOver = false
let obstacles = []

fn spawnParticles(x, y, color, count, type) {
    let i = 0
    while (i < count) {
        let angle = Math.randomInt(0, 360) * 3.14159 / 180
        let speed = Math.randomInt(2, 12)
        let p = {
            x: x,
            y: y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1.0,
            color: color,
            size: Math.randomInt(2, 6),
            type: type
        }
        push(particles, p)
        i = i + 1
    }
}

fn spawnBGParticles() {
    let i = 0
    while (i < 40) {
        push(bgParticles, {
            x: Math.randomInt(0, 900),
            y: Math.randomInt(0, 500),
            speed: Math.randomInt(1, 4),
            size: Math.randomInt(1, 3)
        })
        i = i + 1
    }
}

fn spawnLevel() {
    obstacles = []
    let curX = 600
    
    // Pattern 1: Basic Spikes
    push(obstacles, { type: "spike", x: 800, y: 360, w: 30, h: 40 })
    push(obstacles, { type: "spike", x: 1100, y: 360, w: 30, h: 40 })
    push(obstacles, { type: "spike", x: 1130, y: 360, w: 30, h: 40 })
    
    // Pattern 2: Stairs
    push(obstacles, { type: "block", x: 1400, y: 350, w: 50, h: 50 })
    push(obstacles, { type: "block", x: 1450, y: 300, w: 50, h: 100 })
    push(obstacles, { type: "block", x: 1500, y: 250, w: 50, h: 150 })
    
    // Pattern 3: Floating Platforms
    push(obstacles, { type: "block", x: 1800, y: 220, w: 200, h: 30 })
    push(obstacles, { type: "spike", x: 1880, y: 180, w: 30, h: 40 })
    
    // Pattern 4: Gauntlet
    push(obstacles, { type: "spike", x: 2300, y: 360, w: 30, h: 40 })
    push(obstacles, { type: "spike", x: 2340, y: 360, w: 30, h: 40 })
    push(obstacles, { type: "spike", x: 2380, y: 360, w: 30, h: 40 })
    
    // Pattern 5: High-low
    push(obstacles, { type: "block", x: 2700, y: 300, w: 300, h: 30 })
    push(obstacles, { type: "spike", x: 2800, y: 260, w: 30, h: 40 })
    push(obstacles, { type: "spike", x: 3050, y: 360, w: 30, h: 40 })
    
    // Pattern 6: Column
    push(obstacles, { type: "block", x: 3400, y: 200, w: 60, h: 200 })
    
    // Pattern 7: Leap of faith
    push(obstacles, { type: "block", x: 3800, y: 350, w: 100, h: 50 })
    push(obstacles, { type: "block", x: 4100, y: 350, w: 100, h: 50 })
    push(obstacles, { type: "spike", x: 3950, y: 360, w: 60, h: 40 })
    
    // Pattern 8: Corridor
    push(obstacles, { type: "block", x: 4500, y: 150, w: 500, h: 30 })
    push(obstacles, { type: "block", x: 4500, y: 370, w: 500, h: 30 })
    push(obstacles, { type: "spike", x: 4700, y: 330, w: 30, h: 40 })
    
    // End Pillar
    push(obstacles, { type: "block", x: 5800, y: 0, w: 100, h: 400 })
}

fn resetGame() {
    player.x = 150
    player.y = 350
    player.vy = 0
    player.rotation = 0
    player.alive = true
    cameraX = 0
    gameOver = false
    particles = []
    bgParticles = []
    spawnLevel()
    spawnBGParticles()
    gameOver
}

fn rectOverlap(a, b) {
    let res = true
    if (a.x + a.w < b.x) { res = false }
    if (a.x > b.x + b.w) { res = false }
    if (a.y + a.h < b.y) { res = false }
    if (a.y > b.y + b.h) { res = false }
    res
}

fn update() {
    let t = time()
    let jumping = false
    
    if (!gameOver) {
        jumping = Window.getKeyDown("Space") || Window.getMouseButton()
        if (jumping && player.onGround) {
            player.vy = jumpForce
            player.onGround = false
            spawnParticles(player.x, player.y + player.h, colorPlayer, 5, "burst")
        }
        
        player.vy = player.vy + gravity
        player.y = player.y + player.vy
        player.x = player.x + worldSpeed
        
        player.onGround = false
        if (player.y + player.h >= 400) {
            player.y = 400 - player.h
            player.vy = 0
            player.onGround = true
        }
        
        // Trail
        if (Math.randomInt(0, 10) > 6) {
            push(particles, {
                x: player.x,
                y: player.y + Math.randomInt(0, 35),
                vx: -2,
                vy: (Math.randomInt(0, 20) - 10) / 10,
                life: 0.6,
                color: "rgba(0, 255, 204, 0.4)",
                size: Math.randomInt(2, 4)
            })
        }
        
        let i = 0
        let oLen = len(obstacles)
        while (i < oLen) {
            let o = obstacles[i]
            if (rectOverlap(player, o)) {
                if (o.type == "spike") {
                    player.alive = false
                    gameOver = true
                    spawnParticles(player.x + 17, player.y + 17, colorSpike, 40, "burst")
                }
                if (o.type == "block") {
                    let landing = player.vy >= 0 && (player.y + player.h) <= (o.y + 12)
                    if (landing) {
                        player.y = o.y - player.h
                        player.vy = 0
                        player.onGround = true
                    }
                    if (!landing) {
                        player.alive = false
                        gameOver = true
                        spawnParticles(player.x + 17, player.y + 17, colorSpike, 40, "burst")
                    }
                }
            }
            i = i + 1
        }
        
        if (!player.onGround) {
            player.rotation = player.rotation + rotationSpeed
        }
        if (player.onGround) {
            player.rotation = Math.floor((player.rotation + 45) / 90) * 90
        }
        
        cameraX = player.x - 250
    }
    
    // Update BG Particles
    let bgi = 0
    while (bgi < len(bgParticles)) {
        let bp = bgParticles[bgi]
        bp.x = bp.x - bp.speed
        if (bp.x < 0) { bp.x = 900 }
        bgi = bgi + 1
    }
    
    // Update Particles
    let pi = 0
    while (pi < len(particles)) {
        let p = particles[pi]
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.life = p.life - 0.02
        if (p.life <= 0) { shift(particles) }
        if (p.life > 0) { pi = pi + 1 }
    }
    
    // --- Render ---
    Window.clear(colorBg)
    
    // Background Particles
    let i = 0
    Window.setColor("rgba(255, 255, 255, 0.1)")
    while (i < len(bgParticles)) {
        let bp = bgParticles[i]
        Window.drawCircle(bp.x, bp.y, bp.size)
        i = i + 1
    }
    
    // Grid
    Window.setColor(colorGrid)
    let gridOffset = - ( (cameraX / 1) % 50 )
    let gx = 0
    while (gx < 900) {
        Window.drawRect(gx + gridOffset, 0, 1, 500)
        gx = gx + 50
    }
    let gy = 0
    while (gy < 500) {
        Window.drawRect(0, gy, 900, 1)
        gy = gy + 50
    }
    
    // Floor
    Window.setColor(colorFloor)
    Window.drawRect(0, 400, 900, 100)
    Window.setColor(colorPlayerGlow)
    Window.drawRect(0, 400, 900, 3)
    
    // Obstacles
    let oi = 0
    while (oi < len(obstacles)) {
        let o = obstacles[oi]
        let ox = o.x - cameraX
        if (ox > -300 && ox < 1000) {
            if (o.type == "block") {
                Window.setColor(colorBlock)
                Window.drawRect(ox, o.y, o.w, o.h)
                Window.setColor("rgba(255, 255, 255, 0.1)")
                Window.drawRect(ox + 2, o.y + 2, o.w - 4, o.h - 4)
            }
            if (o.type == "spike") {
                Window.setColor(colorSpike)
                Window.drawRect(ox + 5, o.y + 10, o.w - 10, o.h - 10)
                Window.setColor(colorWhite)
                Window.drawRect(ox + 12, o.y + 20, 6, 6)
            }
        }
        oi = oi + 1
    }
    
    // Particles
    let pj = 0
    while (pj < len(particles)) {
        let p = particles[pj]
        Window.setColor(p.color)
        Window.drawCircle(p.x - cameraX, p.y, p.size * p.life)
        pj = pj + 1
    }
    
    // Player
    if (player.alive) {
        let px = player.x - cameraX
        let py = player.y
        let pulse = 0
        if (!player.onGround) { pulse = Math.sin(t / 50) * 3 }
        
        Window.setColor(colorPlayerGlow)
        Window.drawRect(px - 3, py - 3, player.w + 6, player.h + 6)
        
        Window.setColor(colorPlayer)
        Window.drawRect(px, py, player.w, player.h)
        
        // Face
        Window.setColor(colorBg)
        Window.drawRect(px + 7, py + 8, 8, 8)
        Window.drawRect(px + 20, py + 8, 8, 8)
        if (jumping) {
            Window.drawRect(px + 10, py + 22, 15, 4) // Determined face
        }
    }
    
    // --- Progress Bar ---
    let progress = player.x / levelWidth
    if (progress > 1.0) { progress = 1.0 }
    
    // Background bar
    Window.setColor("rgba(255, 255, 255, 0.1)")
    Window.drawRect(200, 20, 500, 15)
    
    // Filled bar
    Window.setColor(colorProgress)
    Window.drawRect(200, 20, 500 * progress, 15)
    
    // Border
    Window.setColor(colorWhite)
    Window.drawRect(200, 20, 500, 2)
    Window.drawRect(200, 33, 500, 2)
    Window.drawRect(200, 20, 2, 15)
    Window.drawRect(700, 20, 2, 15)
    
    Window.drawText(str(Math.floor(progress * 100)) + "%", 720, 18, 18)
    
    if (gameOver) {
        Window.setColor("rgba(0, 0, 0, 0.8)")
        Window.drawRect(0, 0, 900, 500)
        Window.setColor(colorSpike)
        Window.drawText("LEVEL FAILED", 320, 200, 45)
        Window.setColor(colorWhite)
        Window.drawText("CLICK TO RESET SYSTEM", 330, 270, 20)
        if (Window.getMouseButton()) { resetGame() }
    }
    
    if (progress == 1.0) {
        Window.setColor("rgba(0,0,0,0.8)")
        Window.drawRect(0, 0, 900, 500)
        Window.setColor(colorPlayer)
        Window.drawText("SYNC COMPLETE", 280, 200, 45)
        Window.setColor(colorWhite)
        Window.drawText("SYSTEM OPTIMIZED. CLICK TO REPLAY.", 280, 270, 18)
        if (Window.getMouseButton()) { resetGame() }
    }
    
    t
}

resetGame()
Window.onUpdate(update)
