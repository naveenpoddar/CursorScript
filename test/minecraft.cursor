Window.create(0, 0, "Minecraft Clone (CursorScript)", true)
let scene = Engine3D.createScene()

// 1. Terrain Generation
PerlinNoise.seed(rand(111111, 999999))

let getHeight = (x, z) -> {
    let scale1 = 0.015
    let scale2 = 0.05
    let scale3 = 0.1
    let h1 = PerlinNoise.noise2D(x * scale1, z * scale1) * 35 
    let h2 = PerlinNoise.noise2D(x * scale2, z * scale2) * 12
    let h3 = PerlinNoise.noise2D(x * scale3, z * scale3) * 4
    let combined = h1 + h2 + h3 + 12
    Math.round(combined)
}

// 2. Setup Sun/Light
Engine3D.setLight(scene, 0.5, 1, 0.5, 0.45)
let sunMesh = Engine3D.createCube(scene, 20, "#FFE87C")
let sunGlow1 = Engine3D.createCube(scene, 40, "rgba(255, 232, 124, 0.4)")
let moonMesh = Engine3D.createCube(scene, 15, "#E0E0FF")
let moonGlow = Engine3D.createCube(scene, 30, "rgba(100, 100, 255, 0.2)")

Engine3D.setGlowMode(scene, sunMesh, true)
Engine3D.setGlowMode(scene, sunGlow1, true)
Engine3D.setGlowMode(scene, moonMesh, true)
Engine3D.setGlowMode(scene, moonGlow, true)

Engine3D.setSceneAO(scene, true, 0.5)

let selectorMesh = Engine3D.createCube(scene, 1.05, "rgba(255, 255, 255, 0.3)")
Engine3D.setSolidMode(scene, selectorMesh, false)

// 3. Player Properties
let px = 0
let py = 50
let pz = -8

let yaw = 0
let pitch = 0
let speed = 0.1
let yVel = 0
let isGrounded = false
let breakCooldown = 0
let sunTime = 1.0

let selectedSlot = 0
let hotbar = ["#78e08f", "#d35400", "#7f8c8d", "#86592d", "#228B22"] 
let hotbarNames = ["Grass", "Dirt", "Stone", "Wood", "Leaf"]

let loadedCols = []
let viewDist = 3
let lastChunkX = -999
let lastChunkZ = -999

let skyColor = "rgba(135, 206, 235, 1)"
let lr = 1.0
let lg = 1.0
let lb = 0.9

let checkSolid = (tx, ty, tz) -> {
    Engine3D.checkSolid(scene, tx, ty, tz)
}

Window.disableCursor()

// 4. Physics & World Management Loop
Window.onFixedUpdate(() -> {
    let yawRad = yaw * (Math.PI / 180)
    let moveX = 0
    let moveZ = 0
    
    if (Window.getKeyDown("W")) {
        moveX = moveX + Math.sin(yawRad) * speed
        moveZ = moveZ + Math.cos(yawRad) * speed
    }
    if (Window.getKeyDown("S")) {
        moveX = moveX - Math.sin(yawRad) * speed
        moveZ = moveZ - Math.cos(yawRad) * speed
    }
    if (Window.getKeyDown("A")) {
        moveX = moveX - Math.cos(yawRad) * speed
        moveZ = moveZ + Math.sin(yawRad) * speed
    }
    if (Window.getKeyDown("D")) {
        moveX = moveX + Math.cos(yawRad) * speed
        moveZ = moveZ - Math.sin(yawRad) * speed
    }

    let testX = px + moveX
    let canMoveX = true
    if (checkSolid(testX, py, pz)) { canMoveX = false }
    if (checkSolid(testX, py - 1, pz)) { canMoveX = false }
    if (checkSolid(testX, py - 1.8, pz)) { canMoveX = false }
    if (canMoveX) { px = testX }
    
    let testZ = pz + moveZ
    let canMoveZ = true
    if (checkSolid(px, py, testZ)) { canMoveZ = false }
    if (checkSolid(px, py - 1, testZ)) { canMoveZ = false }
    if (checkSolid(px, py - 1.8, testZ)) { canMoveZ = false }
    if (canMoveZ) { pz = testZ }
    
    yVel = yVel - 0.015
    let newPy = py + yVel
    let floorY = Engine3D.getTopBlockY(scene, px, pz, py - 1.5)

    if (newPy <= floorY + 2.5) {
        newPy = floorY + 2.5
        yVel = 0
        isGrounded = true
    } else {
        isGrounded = false
    }

    if (Window.getKeyDown("Space")) {
        if (isGrounded) {
            yVel = 0.3
            isGrounded = false
        }
    }
    py = newPy

    if (Window.getKeyDown("One")) { selectedSlot = 0 }
    if (Window.getKeyDown("Two")) { selectedSlot = 1 }
    if (Window.getKeyDown("Three")) { selectedSlot = 2 }
    if (Window.getKeyDown("Four")) { selectedSlot = 3 }
    if (Window.getKeyDown("Five")) { selectedSlot = 4 }

    let pitchRad = pitch * (Math.PI / 180)
    let dx = Math.sin(yawRad) * Math.cos(pitchRad)
    let dy = -Math.sin(pitchRad)
    let dz = Math.cos(yawRad) * Math.cos(pitchRad)
    let ray = Engine3D.raycast(scene, px, py, pz, dx, dy, dz, 6)
    
    if (ray.hit) {
        Engine3D.setPosition(scene, selectorMesh, ray.x, ray.y, ray.z)
    } else {
        Engine3D.setPosition(scene, selectorMesh, 0, -9999, 0)
    }

    if (breakCooldown > 0) {
        breakCooldown = breakCooldown - 1
    }
    
    if (ray.hit) {
        if (breakCooldown == 0) {
            if (Window.getMouseButton("left")) {
                breakCooldown = 12
                Engine3D.deleteMesh(scene, ray.meshId)
            } else if (Window.getMouseButton("right")) {
                breakCooldown = 12
                let bCol = hotbar[selectedSlot]
                let cube = Engine3D.createCube(scene, 1, bCol)
                Engine3D.setPosition(scene, cube, ray.px, ray.py, ray.pz)
                Engine3D.setSolidMode(scene, cube, true)
                
                let ci = 0
                while (ci < len(loadedCols)) {
                    let col = loadedCols[ci]
                    if (col.x == Math.floor(ray.px / 16)) {
                        if (col.z == Math.floor(ray.pz / 16)) {
                            push(col.meshes, { id: cube, x: ray.px, y: ray.py, z: ray.pz })
                        }
                    }
                    ci = ci + 1
                }
            }
        }
    }
    
    sunTime = sunTime + 0.002
    let sX = Math.sin(sunTime) * 180
    let sY = Math.cos(sunTime) * 180
    let sZ = 80
    
    let sunFactor = (sY + 20) / 100
    if (sunFactor < 0) { sunFactor = 0 }
    if (sunFactor > 1) { sunFactor = 1 }
    
    let ambient = 0.08 + (sunFactor * 0.37)
    let dlX = sX
    let dlY = sY
    let dlZ = sZ
    
    if (sY < 0) { 
        lr = 0.1
        lg = 0.1
        lb = 0.3
        dlX = -sX
        dlY = -sY
        dlZ = -sZ
    } else {
        let sunset = sY / 40
        if (sunset > 1) { sunset = 1 }
        lr = 1.0
        lg = 0.3 + (sunset * 0.7)
        lb = 0.0 + (sunset * 0.9)
    }
    
    skyColor = Game.lerpColor("rgba(8, 12, 26, 1)", "rgba(135, 206, 235, 1)", sunFactor)
    Engine3D.setLight(scene, dlX, dlY, dlZ, ambient)
    Engine3D.setLightColor(scene, lr, lg, lb)

    let rSY = sY
    if (sY < -20) { rSY = -9999 }
    let rMY = -sY
    if (-sY < -20) { rMY = -9999 }
    
    Engine3D.setPosition(scene, sunMesh, px + sX, py + rSY, pz + sZ)
    Engine3D.setPosition(scene, sunGlow1, px + sX, py + rSY, pz + sZ)
    Engine3D.setPosition(scene, moonMesh, px - sX, py + rMY, pz - sZ)
    Engine3D.setPosition(scene, moonGlow, px - sX, py + rMY, pz - sZ)
    
    Engine3D.setRotation(scene, sunMesh, pitch, -yaw, 0)
    Engine3D.setRotation(scene, sunGlow1, pitch, -yaw, 0)
    Engine3D.setRotation(scene, moonMesh, pitch, -yaw, 0)
    Engine3D.setRotation(scene, moonGlow, pitch, -yaw, 0)

    // --- Dynamic Terrain Management ---
    let chunkX = Math.floor(px / 16)
    let chunkZ = Math.floor(pz / 16)
    
    if (chunkX != lastChunkX) { lastChunkX = chunkX } else { if (chunkZ != lastChunkZ) { lastChunkZ = chunkZ } }
    
    // Simple logic to trigger update if chunk changed
    let chunkChanged = false
    if (chunkX != lastChunkX) { chunkChanged = true }
    if (chunkZ != lastChunkZ) { chunkChanged = true }
    
    if (chunkChanged) {
        lastChunkX = chunkX
        lastChunkZ = chunkZ
        
        let i = 0
        while (i < len(loadedCols)) {
            let col = loadedCols[i]
            let dx = col.x - chunkX
            let dz = col.z - chunkZ
            let dist = Math.abs(dx) + Math.abs(dz)
            if (dist > 6) {
                let j = 0
                while (j < len(col.meshes)) {
                    Engine3D.deleteMesh(scene, col.meshes[j].id)
                    j = j + 1
                }
                loadedCols[i] = loadedCols[len(loadedCols) - 1]
                pop(loadedCols)
            } else {
                i = i + 1
            }
        }
        
        let ox = -viewDist
        while (ox <= viewDist) {
            let oz = -viewDist
            while (oz <= viewDist) {
                let wCX = chunkX + ox
                let wCZ = chunkZ + oz
                
                let isLoaded = false
                let k = 0
                while (k < len(loadedCols)) {
                    let curCol = loadedCols[k]
                    if (curCol.x == wCX) {
                        if (curCol.z == wCZ) {
                            isLoaded = true
                        }
                    }
                    k = k + 1
                }
                
                if (isLoaded == false) {
                    let colMeshes = []
                    let bX = 0
                    while (bX < 16) {
                        let bZ = 0
                        while (bZ < 16) {
                            let wX = (wCX * 16) + bX
                            let wZ = (wCZ * 16) + bZ
                            
                            let h = getHeight(wX, wZ)
                            let h_nx = getHeight(wX - 1, wZ)
                            let h_px = getHeight(wX + 1, wZ)
                            let h_nz = getHeight(wX, wZ - 1)
                            let h_pz = getHeight(wX, wZ + 1)
                            let h_nw = getHeight(wX - 1, wZ - 1)
                            
                            let dirtD = 3
                            let curY = 0
                            while (curY <= h) {
                                let isExposed = false
                                if (curY >= h - 1) { isExposed = true }
                                if (curY > h_nx) { isExposed = true }
                                if (curY > h_px) { isExposed = true }
                                if (curY > h_nz) { isExposed = true }
                                if (curY > h_pz) { isExposed = true }
                                
                                if (isExposed) {
                                    let bColor = "#7f8c8d"
                                    if (curY == h) { bColor = "#78e08f" } 
                                    if (curY < h) {
                                        if (curY > h - dirtD) {
                                           bColor = "#d35400"
                                        }
                                    }
                                    
                                    let cube = Engine3D.createCube(scene, 1, bColor)
                                    Engine3D.setPosition(scene, cube, wX, curY, wZ)
                                    Engine3D.setSolidMode(scene, cube, true)
                                    
                                    let v0 = 0
                                    if (h_nx > curY) { v0 = v0 + 1 }
                                    if (h_nz > curY) { v0 = v0 + 1 }
                                    if (h_nw > curY) { v0 = v0 + 1 }
                                    
                                    Engine3D.setFaceAO(scene, cube, 5, v0, 0, 0, 0)
                                    push(colMeshes, { id: cube, x: wX, y: curY, z: wZ })
                                }
                                curY = curY + 1
                            }
                            bZ = bZ + 1
                        }
                        bX = bX + 1
                    }
                    push(loadedCols, { x: wCX, z: wCZ, meshes: colMeshes })
                }
                oz = oz + 1
            }
            ox = ox + 1
        }
    }
})

// 5. Render & Input Loop
Window.onUpdate(() -> {
    let dx = Window.getMouseDeltaX()
    let dy = Window.getMouseDeltaY()
    yaw = yaw + (dx * 0.1)
    pitch = pitch + (dy * 0.1)
    if (pitch > 90) { pitch = 90 }
    if (pitch < -90) { pitch = -90 }

    let wheel = Window.getMouseWheel()
    if (wheel > 0) { 
        selectedSlot = selectedSlot - 1
        if (selectedSlot < 0) { selectedSlot = 4 }
    }
    if (wheel < 0) { 
        selectedSlot = selectedSlot + 1
        if (selectedSlot > 4) { selectedSlot = 0 }
    }

    Engine3D.setCamera(scene, px, py, pz, pitch, yaw, 0, 300)
    let sw = Window.getWidth()
    let sh = Window.getHeight()
    Window.clear(skyColor)
    Engine3D.render(scene, sw, sh)
    
    Window.setColor("black")
    Window.drawText("Minecraft CursorScript!", 10, 10, 20)
    
    Window.setColor("white")
    Window.drawRect(sw / 2 - 2, sh / 2 - 8, 4, 16)
    Window.drawRect(sw / 2 - 8, sh / 2 - 2, 16, 4)

    let hw = 300
    let hh = 40
    let hx = sw / 2 - (hw / 2)
    let hy = sh - hh - 15
    
    Window.setColor("rgba(0, 0, 0, 0.5)")
    Window.drawRect(hx, hy, hw, hh)
    
    let si = 0
    while (si < 5) {
        let sX = hx + (si * (hw / 5)) + 5
        let sY = hy + 5
        let sS = (hw / 5) - 10
        
        if (si == selectedSlot) {
            Window.setColor("white")
            Window.drawRect(sX - 2, sY - 2, sS + 4, sS + 4)
        } else {
            Window.setColor("gray")
            Window.drawRect(sX - 1, sY - 1, sS + 2, sS + 2)
        }
        
        Window.setColor(hotbar[si])
        Window.drawRect(sX, sY, sS, sS)
        si = si + 1
    }
})
