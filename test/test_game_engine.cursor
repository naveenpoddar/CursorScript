Window.create(800, 600, "Minecraft Clone (CursorScript)")
let scene = Engine3D.createScene()

// 1. Terrain Generation
// Seed the random noise engine
PerlinNoise.seed(rand(111111, 999999))

// 2. Setup Sun/Light
Engine3D.setLight(scene, 0.5, 1, 0.5, 0.45)
let sunMesh = Engine3D.createCube(scene, 20, "#FFE87C") // Sun Core
let sunGlow1 = Engine3D.createCube(scene, 32, "rgba(255, 232, 124, 0.35)") // Inner Glow
let sunGlow2 = Engine3D.createCube(scene, 50, "rgba(255, 232, 124, 0.1)") // Outer Glow

Engine3D.setGlowMode(scene, sunMesh, true)
Engine3D.setGlowMode(scene, sunGlow1, true)
Engine3D.setGlowMode(scene, sunGlow2, true)

// 3. Player Properties
let px = 0
let py = 50
let pz = -8

let yaw = 0
let pitch = 0
let speed = 0.25
let yVel = 0
let isGrounded = false
let breakCooldown = 0

let loadedCols = []
let viewDist = 3  // Changed view distance from 8 to 2 chunks for performance

let getHeight = (x, z) -> {
    let elevation = PerlinNoise.noise2D(x * 0.05, z * 0.05)
    let h = 32 + Math.round(elevation * 16)
    if (h > 64) { h = 64 }
    if (h < 0) { h = 0 }
    h
}

// Lock cursor for FPS view!
Window.disableCursor()

// 4. Game Loop
Window.onUpdate(() -> {
    // --- FPS Mouselook (Locked cursor delta mapping) ---
    let dx = Window.getMouseDeltaX()
    let dy = Window.getMouseDeltaY()
    
    // Scale delta (sensitivity)
    yaw = yaw + (dx * 0.1)
    pitch = pitch + (dy * 0.1)
    
    // Clamp pitch (so player doesn't break their neck)
    if (pitch > 90) { pitch = 90 }
    if (pitch < -90) { pitch = -90 }

    // Convert degrees to radians for mathematical sin/cos
    let yawRad = yaw * (Math.PI / 180)
    
    // --- FPS Movement (WASD Space/Shift) ---
    if (Window.getKeyDown("W")) {
        px = px + Math.sin(yawRad) * speed
        pz = pz + Math.cos(yawRad) * speed
    }
    if (Window.getKeyDown("S")) {
        px = px - Math.sin(yawRad) * speed
        pz = pz - Math.cos(yawRad) * speed
    }
    if (Window.getKeyDown("A")) {
        px = px - Math.cos(yawRad) * speed
        pz = pz + Math.sin(yawRad) * speed
    }
    if (Window.getKeyDown("D")) {
        px = px + Math.cos(yawRad) * speed
        pz = pz - Math.sin(yawRad) * speed
    }
    
    // --- Gravity & Physics ---
    yVel = yVel - 0.015
    let newPy = py + yVel
    
    // Collision checking (floor only for simplicity)
    let floorY = getHeight(Math.round(px), Math.round(pz))
    if (newPy <= floorY + 2.5) {
        newPy = floorY + 2.5
        yVel = 0
        isGrounded = true
    } else {
        isGrounded = false
    }

    if (Window.getKeyDown("Space") && isGrounded == true) {
        yVel = 0.3
        isGrounded = false
    }
    py = newPy
    
    // --- Block Breaking (Mouse Left Click) ---
    if (breakCooldown > 0) { breakCooldown = breakCooldown - 1 }
    // Fallback to getKeyDown if getMouseButtonDown is failing, but WindowLib usually maps getMouseButtonDown
    if (Window.getMouseButtonDown && Window.getMouseButtonDown(0) && breakCooldown == 0) {
        breakCooldown = 15 // About 1/4th second cooldown
        let pitchRad = pitch * (Math.PI / 180)
        let rx = px
        let ry = py
        let rz = pz
        let hit = false
        let step = 0
        
        while (step < 15 && hit == false) {
            rx = rx + Math.sin(yawRad) * Math.cos(pitchRad) * 0.5
            ry = ry - Math.sin(pitchRad) * 0.5
            rz = rz + Math.cos(yawRad) * Math.cos(pitchRad) * 0.5
            
            let bx = Math.round(rx)
            let by = Math.round(ry)
            let bz = Math.round(rz)
            
            let ci = 0
            while (ci < len(loadedCols) && hit == false) {
                let cm = loadedCols[ci].meshes
                let cj = 0
                while (cj < len(cm) && hit == false) {
                    if (cm[cj].x == bx && cm[cj].y == by && cm[cj].z == bz) {
                        Engine3D.deleteMesh(scene, cm[cj].id)
                        cm[cj] = cm[len(cm) - 1]
                        pop(cm)
                        hit = true
                    } else {
                        cj = cj + 1
                    }
                }
                ci = ci + 1
            }
            step = step + 1
        }
    }
    
    // Keep Sun in the sky relative to player (direction 0.5, 1, 0.5)
    Engine3D.setPosition(scene, sunMesh, px + 80, py + 120, pz + 80)
    Engine3D.setPosition(scene, sunGlow1, px + 80, py + 120, pz + 80)
    Engine3D.setPosition(scene, sunGlow2, px + 80, py + 120, pz + 80)

    // --- Dynamic Terrain System ---
    let cx = Math.floor(px)
    let cz = Math.floor(pz)
    
    // Calculate current chunk coordinates
    let chunkX = Math.floor(cx / 16)
    let chunkZ = Math.floor(cz / 16)

    // Unload far chunks
    let i = 0
    while (i < len(loadedCols)) {
        let col = loadedCols[i]
        let dist = Math.abs(col.x - chunkX) + Math.abs(col.z - chunkZ)
        if (dist > viewDist * 1.6) {
            let j = 0
            while (j < len(col.meshes)) {
                Engine3D.deleteMesh(scene, col.meshes[j].id)
                j = j + 1
            }
            // Array fast remove using pop
            let lenCols = len(loadedCols)
            loadedCols[i] = loadedCols[lenCols - 1]
            pop(loadedCols)
        } else {
            i = i + 1
        }
    }

    // Load near chunks (16x16 regions)
    let ox = -viewDist
    while (ox <= viewDist) {
        let oz = -viewDist
        while (oz <= viewDist) {
            let wrldChunkX = chunkX + ox
            let wrldChunkZ = chunkZ + oz
            
            // Only load within a circle to save perf
            if (Math.abs(ox) + Math.abs(oz) <= viewDist * 1.5) {
                let isLoaded = false
                let k = 0
                while (k < len(loadedCols)) {
                    if (loadedCols[k].x == wrldChunkX && loadedCols[k].z == wrldChunkZ) {
                        isLoaded = true
                    }
                    k = k + 1
                }
                
                if (isLoaded == false) {
                    let colMeshes = []
                    
                    // Generate 16x16 blocks for this chunk
                    let bx = 0
                    while (bx < 16) {
                        let bz = 0
                        while (bz < 16) {
                            let wrldX = (wrldChunkX * 16) + bx
                            let wrldZ = (wrldChunkZ * 16) + bz
                            
                            let h = getHeight(wrldX, wrldZ)
                            let h_nx = getHeight(wrldX - 1, wrldZ)
                            let h_px = getHeight(wrldX + 1, wrldZ)
                            let h_nz = getHeight(wrldX, wrldZ - 1)
                            let h_pz = getHeight(wrldX, wrldZ + 1)
                            
                            let min_h = h_nx
                            if (h_px < min_h) { min_h = h_px }
                            if (h_nz < min_h) { min_h = h_nz }
                            if (h_pz < min_h) { min_h = h_pz }
                            
                            // Optimization: Perfect Occlusion Culling. Only render visible shell.
                            let currY = min_h + 1
                            if (currY > h) { currY = h }
                            if (currY < 0) { currY = 0 }
                            
                            while (currY <= h) {
                                let color = "#78e08f" // grass
                                if (currY < h) { color = "#d35400" } // dirt
                                if (currY <= h - 2 && h > 2) { color = "#7f8c8d" } // stone
                                
                                // Ambient Voxel Shadows (Directional shadowing based on sun)
                                if (h_px > currY || h_nz > currY) {
                                    if (color == "#78e08f") { color = "#55a060" } // shadowed grass
                                    else if (color == "#d35400") { color = "#a04000" } // shadowed dirt
                                    else if (color == "#7f8c8d") { color = "#5a6667" } // shadowed stone
                                }
                                
                                let cube = Engine3D.createCube(scene, 1, color)
                                Engine3D.setPosition(scene, cube, wrldX, currY, wrldZ)
                                Engine3D.setSolidMode(scene, cube, true)
                                push(colMeshes, { id: cube, x: wrldX, y: currY, z: wrldZ })
                                
                                // Tree Generation
                                if (currY == h && color == "#78e08f") {
                                    // Deterministic random pseudo-hash based on x/z
                                    let randVal = Math.abs(Math.sin(wrldX * 12.9898 + wrldZ * 78.233)) * 43758.5453
                                    let rand = randVal - Math.floor(randVal)
                                    
                                    // 1% chance to spawn a tree
                                    if (rand < 0.0075) {
                                        // Variable heights between 3 and 7
                                        let treeHeight = 3 + Math.floor(rand * 100) % 5
                                        
                                        // Tree Variations
                                        let leafColor = "#228B22" // Default ForestGreen
                                        let trunkColor = "#8B4513" // Default SaddleBrown
                                        
                                        let varSeed = Math.floor(rand * 1000) % 4
                                        if (varSeed == 0) { 
                                            // Pine / Dark Tree
                                            leafColor = "#006400" // DarkGreen
                                            treeHeight = treeHeight + 1 // Pines are usually taller
                                        }
                                        if (varSeed == 1) {
                                            // Birch
                                            trunkColor = "#F5DEB3" // Wheat/Whiteish
                                            leafColor = "#9ACD32" // YellowGreen
                                        }
                                        if (varSeed == 2) {
                                            // Autumn
                                            leafColor = "#FF8C00" // DarkOrange
                                        }
                                        if (varSeed == 3) {
                                            // Cherry Blossom
                                            leafColor = "#FFB7C5" // Cherry Pink
                                        }
                                        
                                        // Trunk
                                        let ty = 1
                                        while (ty <= treeHeight) {
                                            let trunk = Engine3D.createCube(scene, 1, trunkColor)
                                            Engine3D.setPosition(scene, trunk, wrldX, h + ty, wrldZ)
                                            Engine3D.setSolidMode(scene, trunk, true)
                                            push(colMeshes, { id: trunk, x: wrldX, y: h + ty, z: wrldZ })
                                            ty = ty + 1
                                        }
                                        
                                        // Leaves shape (adjust size based on height)
                                        let leafSpread = 1
                                        if (treeHeight > 5) { leafSpread = 2 }
                                        
                                        let lx = -leafSpread
                                        while (lx <= leafSpread) {
                                            let lz = -leafSpread
                                            while (lz <= leafSpread) {
                                                let maxLy = treeHeight + 1
                                                let minLy = treeHeight - 1
                                                // If tree is wider, drop the leaves one lower
                                                if (leafSpread == 2) { minLy = treeHeight - 2 }
                                                
                                                let ly = minLy
                                                while (ly <= maxLy) {
                                                    // Add randomness to leaves shape to make it organic
                                                    let isCorner = Math.abs(lx) == leafSpread && Math.abs(lz) == leafSpread && ly == maxLy
                                                    if (isCorner == false) {
                                                        // For large leaves, hollow out the corners more
                                                        let isOuterCorner = Math.abs(lx) == leafSpread && Math.abs(lz) == leafSpread && ly == minLy
                                                        if (isOuterCorner == false) {
                                                            let leaf = Engine3D.createCube(scene, 1, leafColor)
                                                            Engine3D.setPosition(scene, leaf, wrldX + lx, h + ly, wrldZ + lz)
                                                            Engine3D.setSolidMode(scene, leaf, true)
                                                            push(colMeshes, { id: leaf, x: wrldX + lx, y: h + ly, z: wrldZ + lz })
                                                        }
                                                    }
                                                    ly = ly + 1
                                                }
                                                lz = lz + 1
                                            }
                                            lx = lx + 1
                                        }
                                    }
                                }
                                
                                currY = currY + 1
                            }
                            bz = bz + 1
                        }
                        bx = bx + 1
                    }
                    
                    push(loadedCols, { x: wrldChunkX, z: wrldChunkZ, meshes: colMeshes })
                }
            }
            oz = oz + 1
        }
        ox = ox + 1
    }

    // Update Camera position in Engine
    // Note: camera FOV is set to 400
    Engine3D.setCamera(scene, px, py, pz, pitch, yaw, 0, 400)
    
    // --- Rendering ---
    Window.clear("#87ceeb") // Beautiful Sky blue background
    Engine3D.render(scene, 800, 600)
    
    // --- UIOverlay ---
    Window.setColor("black")
    Window.drawText("Minecraft Infinite Procedural World!", 10, 10, 20)
    Window.drawText("WASD to move, Mouse to look freely! (ESC to exit)", 10, 35, 16)
    Window.drawText("Space/Shift to fly up/down", 10, 55, 16)
    Window.drawText("X: " + str(cx) + " Z: " + str(cz) + " Loaded Chunks: " + str(len(loadedCols)), 10, 80, 16)
    
    // Quick Crosshair
    Window.setColor("white")
    Window.drawRect(400 - 2, 300 - 10, 4, 20)
    Window.drawRect(400 - 10, 300 - 2, 20, 4)
})
