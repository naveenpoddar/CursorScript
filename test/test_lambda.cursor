let add = (a, b) -> {
    a + b;
}

let result = add(5, 10);
print("Result of lambda add:", result);

let sayHello = () -> {
    print("Hello from lambda!");
}

sayHello();

fn executeCallback(callback) {
    print("Executing callback...");
    callback();
}

executeCallback(() -> {
    print("Lambda callback executed!");
})
