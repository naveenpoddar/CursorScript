async fn main() {
    print("Init");
    const (data, error) = await Network.get("https://jsonplaceholder.typicode.com/todos/1");
    const (data2, error2) = await Network.get("https://jsonplaceholder.typicode.com/todos/2");
    print("After get");

    if (error) {
        printError("Request failed:", error);
    } else {
        print("Received data:", data);
    }

    if (error2) {
        printError("Request failed:", error2);
    } else {
        print("Received data:", data2);
    }
}

print("Before main");
await main();
print("After main");