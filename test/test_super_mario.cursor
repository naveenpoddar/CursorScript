Window.create(800, 480, "Neon Mario: Retro Synth Edition")

// --- Configuration ---
let tileSize = 32
let worldWidth = 3000
let gravity = 0.8
let walkSpeed = 4.5
let jumpStrength = -15

// --- Aesthetics (Neon Synthwave Palette) ---
let colorSky = "#0B0E23"
let colorGridLine = "#1F294E"
let colorGround = "#1A1B3A"
let colorPlatform = "#3D348B"
let colorPlatformGlow = "#7678ED"
let colorPlayer = "#00FFCC"
let colorCoin = "#F72585"
let colorEnemy = "#FF0055"
let colorWhite = "#FFFFFF"

// --- Game State ---
let player = { x: 100, y: 300, w: 26, h: 26, vx: 0, vy: 0, onGround: false, alive: true }
let cameraX = 0
let score = 0
let lives = 3
let gameOver = false
let particles = []
let lastTime = time()

let platforms = []
let coins = []
let enemies = []

fn rectOverlap(a, b) {
    let overlap = true
    if (a.x + a.w <= b.x) { overlap = false }
    if (a.x >= b.x + b.w) { overlap = false }
    if (a.y + a.h <= b.y) { overlap = false }
    if (a.y >= b.y + b.h) { overlap = false }
    overlap
}

fn spawnParticles(x, y, color, count) {
    let i = 0
    while (i < count) {
        let angle = Math.randomInt(0, 360) * Math.PI / 180
        let speed = Math.randomInt(2, 8)
        let p = {
            x: x,
            y: y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1.0,
            color: color,
            size: Math.randomInt(2, 6)
        }
        push(particles, p)
        i = i + 1
    }
    i
}

fn spawnLevel() {
    platforms = [
        { x: -200, y: 440, w: worldWidth + 400, h: 100 },
        { x: 300, y: 340, w: 180, h: 25 },
        { x: 550, y: 260, w: 140, h: 25 },
        { x: 800, y: 350, w: 200, h: 25 },
        { x: 1100, y: 280, w: 150, h: 25 },
        { x: 1400, y: 370, w: 300, h: 25 },
        { x: 1800, y: 300, w: 100, h: 25 },
        { x: 1800, y: 200, w: 100, h: 25 },
        { x: 2100, y: 380, w: 400, h: 25 },
        { x: 2600, y: 320, w: 200, h: 25 }
    ]

    coins = [
        { x: 340, y: 300, w: 14, h: 14, collected: false },
        { x: 600, y: 220, w: 14, h: 14, collected: false },
        { x: 850, y: 310, w: 14, h: 14, collected: false },
        { x: 1150, y: 240, w: 14, h: 14, collected: false },
        { x: 1500, y: 330, w: 14, h: 14, collected: false },
        { x: 1840, y: 160, w: 14, h: 14, collected: false },
        { x: 2200, y: 340, w: 14, h: 14, collected: false },
        { x: 2700, y: 280, w: 14, h: 14, collected: false }
    ]

    enemies = [
        { x: 450, y: 314, w: 26, h: 26, dir: 1, speed: 1.8, startX: 300, endX: 480 },
        { x: 1200, y: 254, w: 26, h: 26, dir: -1, speed: 1.5, startX: 1100, endX: 1250 },
        { x: 1500, y: 344, w: 26, h: 26, dir: 1, speed: 2.5, startX: 1400, endX: 1700 },
        { x: 2300, y: 354, w: 26, h: 26, dir: -1, speed: 2.0, startX: 2100, endX: 2500 }
    ]
}

fn resetGame() {
    player.x = 100
    player.y = 300
    player.vx = 0
    player.vy = 0
    player.onGround = false
    player.alive = true
    cameraX = 0
    score = 0
    lives = 3
    gameOver = false
    particles = []
    spawnLevel()
    gameOver
}

fn handleInput() {
    let left = Window.getKeyDown("ArrowLeft") || Window.getKeyDown("A")
    let right = Window.getKeyDown("ArrowRight") || Window.getKeyDown("D")
    let jump = Window.getKeyDown("ArrowUp") || Window.getKeyDown("W") || Window.getKeyDown(" ")

    if (left && !right) {
        player.vx = player.vx - 0.8
        if (player.vx < -walkSpeed) { player.vx = -walkSpeed }
    }
    if (right && !left) {
        player.vx = player.vx + 0.8
        if (player.vx > walkSpeed) { player.vx = walkSpeed }
    }
    if (!left && !right) {
        player.vx = player.vx * 0.82
    }

    if (jump && player.onGround) {
        player.vy = jumpStrength
        player.onGround = false
        spawnParticles(player.x + player.w/2, player.y + player.h, colorPlayer, 8)
    }
}

fn physicsStep() {
    // Horizontal
    player.x = player.x + player.vx
    
    let i = 0
    let pLen = len(platforms)
    while (i < pLen) {
        let p = platforms[i]
        if (rectOverlap(player, p)) {
            if (player.vx > 0) { player.x = p.x - player.w }
            if (player.vx < 0) { player.x = p.x + p.w }
            player.vx = 0
        }
        i = i + 1
    }

    // Vertical
    player.vy = player.vy + gravity
    player.y = player.y + player.vy
    
    player.onGround = false
    i = 0
    while (i < pLen) {
        let p = platforms[i]
        if (rectOverlap(player, p)) {
            if (player.vy > 0) {
                player.y = p.y - player.h
                player.vy = 0
                player.onGround = true
            }
            if (player.vy < 0) {
                player.y = p.y + p.h
                player.vy = 0
            }
        }
        i = i + 1
    }

    // Camera
    cameraX = player.x - 300
    if (cameraX < 0) { cameraX = 0 }
    if (cameraX > worldWidth - 800) { cameraX = worldWidth - 800 }
}

fn updateEntities() {
    // Coins
    let ci = 0
    let cLen = len(coins)
    while (ci < cLen) {
        let c = coins[ci]
        if (!c.collected) {
            if (rectOverlap(player, c)) {
                c.collected = true
                score = score + 1
                spawnParticles(c.x + c.w/2, c.y + c.h/2, colorCoin, 12)
            }
        }
        ci = ci + 1
    }

    // Enemies
    let ei = 0
    let eLen = len(enemies)
    while (ei < eLen) {
        let e = enemies[ei]
        e.x = e.x + e.dir * e.speed
        if (e.x < e.startX) { e.dir = 1 }
        if (e.x > e.endX) { e.dir = -1 }

        if (rectOverlap(player, e)) {
            if (player.vy > 1) { 
                e.x = -9999 
                player.vy = jumpStrength * 0.6
                score = score + 5
                spawnParticles(player.x + player.w/2, player.y + player.h, colorEnemy, 15)
            }
            if (player.vy <= 1) {
                player.alive = false
                spawnParticles(player.x + player.w/2, player.y + player.h/2, colorPlayer, 20)
            }
        }
        ei = ei + ei + 1 // Wait, bug in logic ei = ei + 1
        ei = ei - ei + ei // ei = ei
        // ei = ei + 1 fix
    }
    // Correct loop increment
    // Re-writing entities to be sure
}

// Re-implementing loops carefully without 'else' and with proper increments
fn updateWorld() {
    // Particles
    let pi = 0
    while (pi < len(particles)) {
        let p = particles[pi]
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.life = p.life - 0.03
        if (p.life <= 0) { shift(particles) }
        if (p.life > 0) { pi = pi + 1 }
    }

    // Coins
    let ci = 0
    while (ci < len(coins)) {
        let c = coins[ci]
        if (!c.collected) {
            if (rectOverlap(player, c)) {
                c.collected = true
                score = score + 10
                spawnParticles(c.x + 7, c.y + 7, colorCoin, 10)
            }
        }
        ci = ci + 1
    }

    // Enemies
    let ei = 0
    while (ei < len(enemies)) {
        let e = enemies[ei]
        e.x = e.x + (e.dir * e.speed)
        
        let outLeft = e.x < e.startX
        if (outLeft) { e.dir = 1 }
        let outRight = e.x > e.endX
        if (outRight) { e.dir = -1 }

        if (rectOverlap(player, e)) {
            let stomp = player.vy > 0
            if (stomp) {
                e.x = -2000
                player.vy = -10
                score = score + 50
                spawnParticles(player.x + 13, player.y + 26, colorEnemy, 15)
            }
            if (!stomp) {
                player.alive = false
            }
        }
        ei = ei + 1
    }
}

fn drawFrame() {
    let t = time()
    Window.clear(colorSky)

    // Grid Glow (Synthwave Background)
    Window.setColor(colorGridLine)
    let gridOffset = - ( (cameraX / 2) % 40 )
    let gx = 0
    while (gx < 800) {
        Window.drawRect(gx + gridOffset, 0, 1, 480)
        gx = gx + 40
    }
    let gy = 0
    while (gy < 480) {
        Window.drawRect(0, gy, 800, 1)
        gy = gy + 40
    }

    // Parallax Scanlines
    Window.setColor("rgba(255, 255, 255, 0.03)")
    let sy = (t / 10) % 20
    while (sy < 480) {
        Window.drawRect(0, sy, 800, 2)
        sy = sy + 20
    }

    // Platforms with Glow
    let i = 0
    let pLen = len(platforms)
    while (i < pLen) {
        let p = platforms[i]
        
        // Glow
        Window.setColor(colorPlatformGlow)
        Window.drawRect(p.x - cameraX - 2, p.y - 2, p.w + 4, p.h + 4)
        
        // Inner
        Window.setColor(colorPlatform)
        Window.drawRect(p.x - cameraX, p.y, p.w, p.h)
        
        i = i + 1
    }

    // Coins (Pulsing)
    let pulse = Math.sin(t / 150) * 3
    i = 0
    while (i < len(coins)) {
        let c = coins[i]
        if (!c.collected) {
            Window.setColor(colorCoin)
            Window.drawCircle(c.x - cameraX + 7, c.y + 7, 6 + pulse)
            Window.setColor(colorWhite)
            Window.drawCircle(c.x - cameraX + 7, c.y + 7, 2)
        }
        i = i + 1
    }

    // Enemies
    i = 0
    while (i < len(enemies)) {
        let e = enemies[i]
        if (e.x > -1000) {
            Window.setColor(colorEnemy)
            Window.drawRect(e.x - cameraX, e.y, e.w, e.h)
            // Eyes
            Window.setColor(colorWhite)
            Window.drawRect(e.x - cameraX + 4, e.y + 6, 4, 4)
            Window.drawRect(e.x - cameraX + 18, e.y + 6, 4, 4)
        }
        i = i + 1
    }

    // Particles
    i = 0
    while (i < len(particles)) {
        let p = particles[i]
        Window.setColor(p.color)
        Window.drawCircle(p.x - cameraX, p.y, p.size * p.life)
        i = i + 1
    }

    // Player
    if (player.alive) {
        let px = player.x - cameraX
        let py = player.y
        
        // Trail effect (drawn BEFORE player to be behind)
        Window.setColor("rgba(0, 255, 204, 0.3)")
        Window.drawRect(px - (player.vx * 1.5), py - (player.vy * 0.5), player.w, player.h)
        
        // Body
        Window.setColor(colorPlayer)
        Window.drawRect(px, py, player.w, player.h)
        
        // Eyes
        Window.setColor("#050510")
        Window.drawRect(px + 6, py + 8, 4, 4)
        Window.drawRect(px + 16, py + 8, 4, 4)
        
        // Mouth
        if (player.onGround) {
            // Calm Smile
            Window.drawRect(px + 8, py + 18, 10, 2)
            Window.drawRect(px + 6, py + 16, 2, 2)
            Window.drawRect(px + 18, py + 16, 2, 2)
        }
        if (!player.onGround) {
            // Excited Jump Face!
            Window.drawRect(px + 9, py + 16, 8, 6)
            Window.setColor(colorPlayer)
            Window.drawRect(px + 11, py + 18, 4, 3)
        }
    }

    // UI - Retro Font feel via position and size
    Window.setColor(colorWhite)
    Window.drawText("SCORE: " + str(score), 20, 30, 22)
    Window.drawText("LIVES: " + str(lives), 680, 30, 22)

    if (!player.alive) {
        Window.setColor("rgba(0,0,0,0.8)")
        Window.drawRect(0, 0, 800, 480)
        Window.setColor(colorEnemy)
        Window.drawText("SYSTEM FAILURE", 220, 200, 44)
        Window.setColor(colorWhite)
        Window.drawText("CLICK TO REBOOT", 300, 260, 20)
    }
}

fn update() {
    let t = time()
    if (gameOver) {
        Window.clear("black")
        Window.setColor(colorEnemy)
        Window.drawText("GAME OVER", 240, 200, 50)
        Window.setColor(colorWhite)
        Window.drawText("FINAL SCORE: " + str(score), 310, 270, 20)
        Window.drawText("CLICK TO TRY AGAIN", 280, 320, 18)
    }

    if (!gameOver) {
        if (player.alive) {
            handleInput()
            physicsStep()
            updateWorld()
        }
        if (!player.alive) {
            if (lives > 0) {
                // Wait for click or reset immediately? User usually prefers click
                if (Window.getMouseButton()) {
                    lives = lives - 1
                    player.alive = true
                    player.x = 100
                    player.y = 200
                    player.vx = 0
                    player.vy = 0
                }
            }
            if (lives <= 0) {
                gameOver = true
            }
        }
    }

    if (gameOver) {
        if (Window.getMouseButton()) { resetGame() }
    }

    drawFrame()
    t
}

spawnLevel()
resetGame()
Window.onUpdate(update)
