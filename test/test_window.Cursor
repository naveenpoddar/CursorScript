Window.create(640, 480, "Cursor++ Unity-Style Engine")

let x = 50;
let y = 50;
let speedX = 5;
let speedY = 4;

fn update() {
    Window.clear("black")
    
    // Draw text
    Window.setColor("white")
    Window.drawText("Unity-style Loop in CursorScript", 20, 40, 24)
    
    // Draw Player (Bouncing Ball)
    Window.setColor("#00ffcc")
    Window.drawCircle(x, y, 25)
    
    // Draw a rectangle
    Window.setColor("red")
    Window.strokeRect(50, 50, 540, 380)
    
    // Update Position
    x = x + speedX
    y = y + speedY
    
    // Bounce logic
    if (x > 565) { speedX = -5 }
    if (x < 75) { speedX = 5 }
    if (y > 405) { speedY = -4 }
    if (y < 75) { speedY = 4 }
}

Window.onUpdate(update)
