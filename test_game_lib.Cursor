print("Testing Game Library...")

// Test Collision
const rect1 = { x: 0, y: 0, w: 10, h: 10 };
const rect2 = { x: 5, y: 5, w: 10, h: 10 };
const rect3 = { x: 20, y: 20, w: 10, h: 10 };

print("Intersects 1 & 2:", Game.intersectRect(rect1.x, rect1.y, rect1.w, rect1.h, rect2.x, rect2.y, rect2.w, rect2.h))
print("Intersects 1 & 3:", Game.intersectRect(rect1.x, rect1.y, rect1.w, rect1.h, rect3.x, rect3.y, rect3.w, rect3.h))

// Test Movement
print("Move 0 to 10 by 2:", Game.moveTowards(0, 10, 2))
print("Lerp 0 to 10 by 0.5:", Game.lerp(0, 10, 0.5))

// Test Random
print("Chance 50%:", Game.chance(0.5))
print("Choose from [1, 2, 3]:", Game.choose(1, 2, 3))

// Test Angles
const rad = Game.degToRad(180);
print("180 deg to rad:", rad)
print("rad to deg:", Game.radToDeg(rad))

// Test Ping Pong
print("PingPong 1.5 length 1.0:", Game.pingPong(1.5, 1.0))
